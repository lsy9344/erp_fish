# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# Generate a new secret for each PC with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"
AUTH_TRUST_HOST="true"

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:erp_fish_local_pw@localhost:5432/erp_fish"

# Development headquarters seed account
SEED_HQ_EMAIL="admin@example.com"
SEED_HQ_PASSWORD="replace-with-local-hq-seed-secret"
SEED_HQ_NAME="본사 관리자"
SEED_STORE_MANAGER_EMAIL="store-manager@example.com"
SEED_STORE_MANAGER_PASSWORD="replace-with-local-store-seed-secret"
SEED_STORE_MANAGER_NAME="샘플 지점장"
SEED_SAMPLE_STORE_NAME="샘플 지점"
ALLOW_PRODUCTION_SEED=""
ALLOW_SEED_PASSWORD_ROTATION=""

# LINE 오전 요약 알림 (WO-10)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_MORNING_SUMMARY_RECIPIENT_IDS=
INTERNAL_CRON_SECRET=

# 데이터 질의 챗봇 (POST /api/chat)
# 비워 두면 챗봇은 503과 "아직 설정되지 않았습니다" 안내를 반환한다.
# OPENAI_CHAT_MODEL은 소형(mini) 등급을 쓴다. 미설정 시 코드 기본값.
# OPENAI_API_BASE_URL은 테스트 스텁 전용이며 운영에서는 비워 둔다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_API_BASE_URL=
