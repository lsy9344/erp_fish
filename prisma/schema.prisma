// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

enum UserRole {
  HEADQUARTERS
  STORE_MANAGER
}

enum StoreAccessMode {
  ALL_STORES
  ASSIGNED_STORES
}

enum PermissionAction {
  LEDGER_CREATE
  LEDGER_EDIT
  LEDGER_CLOSED_EDIT
  LEDGER_HQ_CLOSE
  CORRECTION_CREATE
  UPLOAD_PREVIEW
  UPLOAD_COMMIT
  SETTINGS_MANAGE
  REPORT_VIEW
  EXPORT_CREATE
  USER_PERMISSION_MANAGE
  // WO-0806 #5: 직원 관리·인건비 현황 전용. 대표(OWNER) 프로필에만 부여한다.
  LABOR_VIEW
  // WO(2026-08-14): 사용자/지점 영구 삭제 전용. 되돌릴 수 없어 SETTINGS_MANAGE와
  // 분리하고, 대표(OWNER)와 `기준정보 삭제` 프로필에만 부여한다.
  MASTER_DATA_DELETE
}

enum DailyLedgerStatus {
  IN_PROGRESS
  IN_REVIEW
  HEADQUARTERS_CLOSED
  HOLIDAY
}

enum LedgerInputCodeGroup {
  PAYMENT_METHOD
  EXPENSE_ITEM
  LOSS_TYPE
}

enum InventoryCarryoverSource {
  OPENING_SNAPSHOT
  PREVIOUS_CLOSED_LEDGER
  PREVIOUS_SAVED_LEDGER
  MANUAL
}

enum InventoryCarryoverStatus {
  PREVIOUS_CARRYOVER
  REVIEW_REQUIRED
  CARRYOVER_EMPTY
  CARRYOVER_RECHECK_REQUIRED
  OPENING_CARRYOVER
  DATA_INSUFFICIENT
  POLICY_UNCONFIRMED
}

enum InventoryAdjustmentAmountStatus {
  POLICY_UNCONFIRMED
  CONFIRMED
}

enum LedgerPurchaseSource {
  MANUAL
  ECOUNT_UPLOAD
}

enum InventoryLotSource {
  OPENING
  PREVIOUS_CARRYOVER
  PURCHASE
  LEGACY_OPENING
}

enum CorrectionTargetType {
  LEDGER_FIELD
  PAYMENT_FIELD
  EXPENSE_ROW
  PURCHASE_ROW
  INVENTORY_ROW
  LOSS_ROW
  CALCULATED_METRIC
}

enum HistoricalEmployeeRole {
  LEAD
  MEMBER
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

model Store {
  id                          String   @id @default(cuid())
  name                        String   @unique
  isActive                    Boolean  @default(true)
  reportMarginGapThresholdBps Int      @default(500)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  updatedById                 String?

  assignments                  UserStoreAssignment[]
  updatedBy                    User?                         @relation("StoreUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  dailyLedgers                 DailyLedger[]
  inventoryOpeningSnapshots    InventoryOpeningSnapshot[]
  ledgerInputCodeAliases       LedgerInputCodeStoreAlias[]
  salesPricePlans              StoreSalesPricePlan[]
  headquartersExpenses         HeadquartersExpense[]
  externalAliases              StoreExternalAlias[]
  ecountImportLines            EcountImportLine[]
  // 승인된 고객 Excel 과거 실적/역할. 운영 DailyLedger와 의도적으로 분리한다.
  historicalDailyFacts         HistoricalDailyFact[]
  historicalEmployeeDailyRoles HistoricalEmployeeDailyRole[]
  employees                    Employee[]

  @@index([isActive])
  @@index([updatedById])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  category         String
  spec             String
  // 정책 전환(2026-06-24): 품목 마스터 단가는 본사 매입가/기준 매입가가 아니다.
  // 입고 원가의 권위 있는 source는 이카운트 라인(EcountImportLine.unitPrice)과
  // 장부 적용 단가(LedgerPurchaseItem.unitPrice)다. 마스터 단가는 선택적 "참고 단가"로만
  // 남기고, 어떤 계산의 무음 fallback으로도 쓰지 않는다. 신규 품목은 단가 없이 생성 가능하다.
  defaultUnitPrice Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  updatedById      String?

  updatedBy                  User?                       @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  purchaseStandards          PurchaseStandard[]
  ledgerPurchaseItems        LedgerPurchaseItem[]
  ledgerInventoryItems       LedgerInventoryItem[]
  ledgerInventoryFifoLots    LedgerInventoryFifoLot[]
  ledgerLotSalesPricePlans   LedgerLotSalesPricePlan[]
  ledgerLossLotAllocations   LedgerLossLotAllocation[]
  ledgerInventoryAdjustments LedgerInventoryAdjustment[]
  ledgerLossItems            LedgerLossItem[]
  inventoryOpeningSnapshots  InventoryOpeningSnapshot[]
  salesPricePlans            StoreSalesPricePlan[]
  externalAliases            ProductExternalAlias[]
  ecountImportLines          EcountImportLine[]

  @@unique([name, category, spec])
  @@index([category])
  @@index([isActive])
  @@index([updatedById])
}

// DEPRECATED(2026-06-24): 이카운트 정책 전환으로 단계적 비활성화. 물리 삭제는 별도 migration에서 결정한다.
// 신규 매입 라인은 PurchaseStandard를 연결하지 않고 Product.defaultUnitPrice를 참고값으로만 사용한다.
model PurchaseStandard {
  id                String   @id @default(cuid())
  productId         String   @unique
  standardUnitPrice Int?
  referenceInfo     String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedById       String?

  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  updatedBy           User?                @relation("PurchaseStandardUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  ledgerPurchaseItems LedgerPurchaseItem[]

  @@index([isActive])
  @@index([updatedById])
}

model LedgerInputCode {
  id           String               @id @default(cuid())
  group        LedgerInputCodeGroup
  name         String
  displayOrder Int
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  updatedById  String?

  updatedBy       User?                       @relation("LedgerInputCodeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  ledgerExpenses  LedgerExpense[]
  ledgerLossItems LedgerLossItem[]
  storeAliases    LedgerInputCodeStoreAlias[]

  @@unique([group, name])
  @@index([group, displayOrder])
  @@index([isActive])
  @@index([updatedById])
}

// 미팅 결정(2026-06-21): 코드 등록은 본사가 하되, 각 지점은 화면 표시명만
// 자기 지점용으로 덮어쓸 수 있다. 코드 자체(키/값/활성)는 본사 전용으로 유지.
model LedgerInputCodeStoreAlias {
  id                String   @id @default(cuid())
  ledgerInputCodeId String
  storeId           String
  displayName       String
  createdById       String
  updatedById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ledgerInputCode LedgerInputCode @relation(fields: [ledgerInputCodeId], references: [id], onDelete: Cascade)
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("LedgerInputCodeStoreAliasCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User            @relation("LedgerInputCodeStoreAliasUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([ledgerInputCodeId, storeId])
  @@index([storeId])
  @@index([createdById])
  @@index([updatedById])
}

model UserStoreAssignment {
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
}

model PermissionProfile {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  description     String?
  isSystem        Boolean         @default(false)
  isActive        Boolean         @default(true)
  storeAccessMode StoreAccessMode
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  actions PermissionProfileAction[]
  users   UserPermissionProfile[]

  @@index([isActive])
  @@index([storeAccessMode])
}

model PermissionProfileAction {
  profileId String
  action    PermissionAction
  createdAt DateTime         @default(now())

  profile PermissionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, action])
  @@index([action])
}

model UserPermissionProfile {
  userId    String
  profileId String
  createdAt DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile PermissionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([userId, profileId])
  @@index([profileId])
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                                  String                      @id @default(cuid())
  name                                String?
  email                               String?                     @unique
  emailVerified                       DateTime?
  image                               String?
  role                                UserRole                    @default(STORE_MANAGER)
  passwordHash                        String?
  isActive                            Boolean                     @default(true)
  createdAt                           DateTime                    @default(now())
  updatedAt                           DateTime                    @default(now()) @updatedAt
  accounts                            Account[]
  sessions                            Session[]
  posts                               Post[]
  storeAssignments                    UserStoreAssignment[]
  permissionProfiles                  UserPermissionProfile[]
  updatedStores                       Store[]                     @relation("StoreUpdatedBy")
  updatedProducts                     Product[]                   @relation("ProductUpdatedBy")
  updatedPurchaseStandards            PurchaseStandard[]          @relation("PurchaseStandardUpdatedBy")
  updatedLedgerInputCodes             LedgerInputCode[]           @relation("LedgerInputCodeUpdatedBy")
  updatedAnomalyThresholdSettings     AnomalyThresholdSetting[]   @relation("AnomalyThresholdSettingUpdatedBy")
  updatedLongStockThresholdSettings   LongStockThresholdSetting[] @relation("LongStockThresholdSettingUpdatedBy")
  createdDailyLedgers                 DailyLedger[]               @relation("LedgerCreatedBy")
  updatedDailyLedgers                 DailyLedger[]               @relation("LedgerUpdatedBy")
  submittedDailyLedgers               DailyLedger[]               @relation("LedgerSubmittedBy")
  closedDailyLedgers                  DailyLedger[]               @relation("LedgerClosedBy")
  lossReviewedDailyLedgers            DailyLedger[]               @relation("LedgerLossReviewedBy")
  createdLedgerExpenses               LedgerExpense[]             @relation("LedgerExpenseCreatedBy")
  updatedLedgerExpenses               LedgerExpense[]             @relation("LedgerExpenseUpdatedBy")
  createdLedgerPurchaseItems          LedgerPurchaseItem[]        @relation("LedgerPurchaseItemCreatedBy")
  updatedLedgerPurchaseItems          LedgerPurchaseItem[]        @relation("LedgerPurchaseItemUpdatedBy")
  createdLedgerInventoryItems         LedgerInventoryItem[]       @relation("LedgerInventoryItemCreatedBy")
  updatedLedgerInventoryItems         LedgerInventoryItem[]       @relation("LedgerInventoryItemUpdatedBy")
  createdLedgerInventoryAdjustments   LedgerInventoryAdjustment[] @relation("LedgerInventoryAdjustmentCreatedBy")
  updatedLedgerInventoryAdjustments   LedgerInventoryAdjustment[] @relation("LedgerInventoryAdjustmentUpdatedBy")
  createdLedgerLossItems              LedgerLossItem[]            @relation("LedgerLossItemCreatedBy")
  updatedLedgerLossItems              LedgerLossItem[]            @relation("LedgerLossItemUpdatedBy")
  createdLedgerLaborItems             LedgerLaborItem[]           @relation("LedgerLaborItemCreatedBy")
  updatedLedgerLaborItems             LedgerLaborItem[]           @relation("LedgerLaborItemUpdatedBy")
  createdCorrectionRecords            CorrectionRecord[]          @relation("CorrectionRecordCreatedBy")
  supersededCorrectionRecords         CorrectionRecord[]          @relation("CorrectionRecordSupersededBy")
  createdLedgerInputCodeAliases       LedgerInputCodeStoreAlias[] @relation("LedgerInputCodeStoreAliasCreatedBy")
  updatedLedgerInputCodeAliases       LedgerInputCodeStoreAlias[] @relation("LedgerInputCodeStoreAliasUpdatedBy")
  createdStoreSalesPricePlans         StoreSalesPricePlan[]       @relation("StoreSalesPricePlanCreatedBy")
  updatedStoreSalesPricePlans         StoreSalesPricePlan[]       @relation("StoreSalesPricePlanUpdatedBy")
  createdLedgerLotSalesPricePlans     LedgerLotSalesPricePlan[]   @relation("LedgerLotSalesPricePlanCreatedBy")
  updatedLedgerLotSalesPricePlans     LedgerLotSalesPricePlan[]   @relation("LedgerLotSalesPricePlanUpdatedBy")
  createdHeadquartersExpenses         HeadquartersExpense[]       @relation("HeadquartersExpenseCreatedBy")
  updatedHeadquartersExpenses         HeadquartersExpense[]       @relation("HeadquartersExpenseUpdatedBy")
  unitPriceUpdatedLedgerPurchaseItems LedgerPurchaseItem[]        @relation("LedgerPurchaseItemUnitPriceUpdatedBy")
  uploadedEcountImportBatches         EcountImportBatch[]         @relation("EcountImportBatchUploadedBy")
  committedEcountImportBatches        EcountImportBatch[]         @relation("EcountImportBatchCommittedBy")
  voidedEcountImportBatches           EcountImportBatch[]         @relation("EcountImportBatchVoidedBy")
  updatedStoreExternalAliases         StoreExternalAlias[]        @relation("StoreExternalAliasUpdatedBy")
  updatedProductExternalAliases       ProductExternalAlias[]      @relation("ProductExternalAliasUpdatedBy")
  auditLogs                           AuditLog[]                  @relation("AuditActor")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  targetType String
  targetId   String
  actorId    String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([createdAt])
  @@index([targetType, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model AnomalyThresholdSetting {
  id                          String   @id @default(cuid())
  scope                       String   @unique @default("GLOBAL")
  marginRateBps               Int
  inventoryDifferenceQuantity Int
  isActive                    Boolean  @default(true)
  updatedById                 String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  updatedBy User? @relation("AnomalyThresholdSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([updatedById])
}

// WO-13(2026-06-28): 품목군(category)별 장기재고 기준일. 본사가 "이 분류는 며칠 이상
// 남으면 장기재고"인지 관리한다. 기준이 없는 분류는 "기준 확인 필요"로 두고 장기재고
// 알림 대상에서 제외한다(생물 3~4일 같은 현장 기준을 하드코딩 30일 대신 설정으로 관리).
model LongStockThresholdSetting {
  id            String   @id @default(cuid())
  category      String   @unique
  thresholdDays Int
  isActive      Boolean  @default(true)
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  updatedBy User? @relation("LongStockThresholdSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([updatedById])
}

model DailyLedger {
  id                         String                      @id @default(cuid())
  storeId                    String
  closingDate                DateTime
  status                     DailyLedgerStatus           @default(IN_PROGRESS)
  version                    Int                         @default(1)
  authorDisplayName          String?
  totalSalesAmount           Int                         @default(0)
  carryoverSalesAmount       Int                         @default(0)
  cashAmount                 Int                         @default(0)
  cardAmount                 Int                         @default(0)
  otherPaymentAmount         Int                         @default(0)
  workerCount                Int?
  workMemo                   String?
  submittedById              String?
  submittedAt                DateTime?
  closedById                 String?
  closedAt                   DateTime?
  // 손실→재고 순서 보장용: 손실 항목이 0건이어도 점주가 4단계 손실/폐기를 저장해
  // 검토 완료했음을 기록한다. 재고 저장은 이 값이 있어야 진행한다.
  lossReviewedById           String?
  lossReviewedAt             DateTime?
  ledgerExpenses             LedgerExpense[]
  ledgerPurchaseItems        LedgerPurchaseItem[]
  ledgerInventoryItems       LedgerInventoryItem[]
  ledgerInventoryFifoLots    LedgerInventoryFifoLot[]
  ledgerLotSalesPricePlans   LedgerLotSalesPricePlan[]
  ledgerLossLotAllocations   LedgerLossLotAllocation[]
  ledgerInventoryAdjustments LedgerInventoryAdjustment[]
  ledgerLossItems            LedgerLossItem[]
  ledgerLaborItems           LedgerLaborItem[]
  correctionRecords          CorrectionRecord[]
  createdById                String
  updatedById                String
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  store          Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdBy      User  @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User  @relation("LedgerUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  submittedBy    User? @relation("LedgerSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  closedBy       User? @relation("LedgerClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  lossReviewedBy User? @relation("LedgerLossReviewedBy", fields: [lossReviewedById], references: [id], onDelete: SetNull)

  @@unique([storeId, closingDate], map: "dailyLedger_storeId_closingDate_key")
  @@index([storeId, closingDate])
  @@index([status])
  @@index([submittedById])
  @@index([closedById])
}

model CorrectionRecord {
  id                   String               @id @default(cuid())
  dailyLedgerId        String
  targetType           CorrectionTargetType
  targetId             String
  fieldKey             String
  originalValue        Json
  previousAppliedValue Json
  correctedValue       Json
  reason               String
  createdById          String
  createdAt            DateTime             @default(now())
  supersededAt         DateTime?
  supersededById       String?
  supersedeReason      String?

  dailyLedger  DailyLedger @relation(fields: [dailyLedgerId], references: [id], onDelete: Restrict)
  createdBy    User        @relation("CorrectionRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  supersededBy User?       @relation("CorrectionRecordSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)

  @@index([dailyLedgerId])
  @@index([createdById])
  @@index([createdAt])
  @@index([supersededById])
  @@index([dailyLedgerId, supersededAt])
  @@index([dailyLedgerId, targetType, targetId, fieldKey, createdAt])
  @@index([dailyLedgerId, targetType, targetId, fieldKey, supersededAt, createdAt], map: "CorrectionRecord_active_target_createdAt_idx")
}

model LedgerExpense {
  id                String   @id @default(cuid())
  dailyLedgerId     String
  ledgerInputCodeId String
  amount            Int
  memo              String?
  createdById       String
  updatedById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dailyLedger     DailyLedger     @relation(fields: [dailyLedgerId], references: [id], onDelete: Restrict)
  ledgerInputCode LedgerInputCode @relation(fields: [ledgerInputCodeId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("LedgerExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User            @relation("LedgerExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([dailyLedgerId])
  @@index([ledgerInputCodeId])
}

model LedgerPurchaseItem {
  id                      String               @id @default(cuid())
  // 매입 행이 수정 과정에서 delete+recreate되어도 같은 입고분임을 식별하는 영구 키.
  // 기존 행은 migration에서 id를 복사하고, 새 행은 DB UUID 기본값을 사용한다.
  lotOriginKey            String               @unique @default(dbgenerated("(gen_random_uuid())::text"))
  dailyLedgerId           String
  productId               String?
  // DEPRECATED(2026-06-24): PurchaseStandard 단계적 비활성화. 신규 라인은 연결하지 않는다.
  purchaseStandardId      String?
  sourceType              LedgerPurchaseSource @default(MANUAL)
  productName             String
  productCategory         String
  productSpec             String
  // unitPrice = 장부 적용 단가(재고/FIFO/마진 계산 기준). amount = unitPrice * quantity.
  unitPrice               Int
  quantity                Decimal              @db.Decimal(12, 2)
  amount                  Int
  referenceInfo           String?
  // 이카운트 출고/입고 라인 원본 추적. 원본 단가는 sourceUnitPrice / EcountImportLine.unitPrice에 보존한다.
  ecountImportLineId      String?              @unique
  sourceUnitPrice         Int?
  unitPriceOverrideReason String?
  unitPriceUpdatedById    String?
  unitPriceUpdatedAt      DateTime?
  createdById             String
  updatedById             String
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  dailyLedger             DailyLedger              @relation(fields: [dailyLedgerId], references: [id], onDelete: Restrict)
  product                 Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseStandard        PurchaseStandard?        @relation(fields: [purchaseStandardId], references: [id], onDelete: SetNull)
  ecountImportLine        EcountImportLine?        @relation("EcountImportLineLedgerPurchaseItem", fields: [ecountImportLineId], references: [id], onDelete: SetNull)
  ledgerInventoryFifoLots LedgerInventoryFifoLot[]
  createdBy               User                     @relation("LedgerPurchaseItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy               User                     @relation("LedgerPurchaseItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  unitPriceUpdatedBy      User?                    @relation("LedgerPurchaseItemUnitPriceUpdatedBy", fields: [unitPriceUpdatedById], references: [id], onDelete: SetNull)

  @@index([dailyLedgerId])
  @@index([productId])
  @@index([purchaseStandardId])
  @@index([sourceType])
  @@index([unitPriceUpdatedById])
}

model LedgerInventoryItem {
  id                String                   @id @default(cuid())
  dailyLedgerId     String
  productId         String
  productName       String
  productCategory   String
  productSpec       String
  unitPrice         Int
  previousQuantity  Decimal                  @db.Decimal(12, 2)
  purchasedQuantity Decimal                  @default(0) @db.Decimal(12, 2)
  currentQuantity   Decimal?                 @db.Decimal(12, 2)
  quantity          Decimal?                 @db.Decimal(12, 2)
  inventoryAmount   Int?
  isModified        Boolean                  @default(false)
  carryoverSource   InventoryCarryoverSource @default(MANUAL)
  carryoverStatus   InventoryCarryoverStatus @default(DATA_INSUFFICIENT)
  carryoverLedgerId String?
  createdById       String
  updatedById       String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  dailyLedger               DailyLedger                     @relation(fields: [dailyLedgerId], references: [id], onDelete: Restrict)
  product                   Product                         @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy                 User                            @relation("LedgerInventoryItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                 User                            @relation("LedgerInventoryItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  ledgerInventoryAdjustment LedgerInventoryAdjustment?
  carryoverDetail           LedgerInventoryCarryoverDetail?
  fifoLots                  LedgerInventoryFifoLot[]

  @@unique([dailyLedgerId, productId], map: "ledgerInventoryItem_dailyLedgerId_productId_key")
  @@index([dailyLedgerId])
  @@index([productId])
  @@index([carryoverLedgerId])
}

model LedgerInventoryCarryoverDetail {
  id                      String                   @id @default(cuid())
  ledgerInventoryItemId   String                   @unique
  source                  InventoryCarryoverSource
  status                  InventoryCarryoverStatus
  resolvedQuantity        Decimal                  @db.Decimal(12, 2)
  sourceLedgerId          String?
  sourceLedgerClosingDate DateTime?
  sourceLedgerStatus      DailyLedgerStatus?
  sourceYearMonth         String?
  sourceSnapshotId        String?
  sourcePreviousQuantity  Decimal?                 @db.Decimal(12, 2)
  sourcePurchasedQuantity Decimal?                 @db.Decimal(12, 2)
  sourceLossQuantity      Decimal?                 @db.Decimal(12, 2)
  sourceCurrentQuantity   Decimal?                 @db.Decimal(12, 2)
  sourceQuantity          Decimal?                 @db.Decimal(12, 2)
  message                 String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  ledgerInventoryItem LedgerInventoryItem @relation(fields: [ledgerInventoryItemId], references: [id], onDelete: Cascade)

  @@index([sourceLedgerId])
  @@index([sourceSnapshotId])
  @@index([source, status])
}

model LedgerInventoryFifoLot {
  id                    String             @id @default(cuid())
  // 전날 이월과 FIFO 재계산을 지나도 바뀌지 않는 입고분 식별자.
  lotOriginKey          String             @default(dbgenerated("(gen_random_uuid())::text"))
  dailyLedgerId         String
  ledgerInventoryItemId String?
  productId             String
  sourceType            InventoryLotSource
  sourceLedgerId        String?
  sourcePurchaseItemId  String?
  unitPrice             Int
  originalQuantity      Decimal            @db.Decimal(12, 2)
  consumedQuantity      Decimal            @db.Decimal(12, 2)
  lossQuantity          Decimal            @default(0) @db.Decimal(12, 2)
  soldQuantity          Decimal            @default(0) @db.Decimal(12, 2)
  remainingQuantity     Decimal            @db.Decimal(12, 2)
  originalAmount        Int
  consumedAmount        Int
  lossAmount            Int                @default(0)
  soldAmount            Int                @default(0)
  remainingAmount       Int
  sortOrder             Int
  // WO-G(2026-06-22): lot의 실제 영업 기준일. 장기 체화 재고 판정이 데이터 입력 시각
  // (createdAt)이 아니라 영업일을 기준으로 동작하도록 한다.
  // PURCHASE는 매입 장부의 closingDate, 이월/기초 lot은 원천 영업일을 보존한다.
  sourceBusinessDate    DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  dailyLedger         DailyLedger          @relation(fields: [dailyLedgerId], references: [id], onDelete: Cascade)
  ledgerInventoryItem LedgerInventoryItem? @relation(fields: [ledgerInventoryItemId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourcePurchaseItem  LedgerPurchaseItem?  @relation(fields: [sourcePurchaseItemId], references: [id], onDelete: SetNull)

  @@unique([dailyLedgerId, productId, sortOrder], map: "ledgerInventoryFifoLot_dailyLedgerId_productId_sortOrder_key")
  @@index([dailyLedgerId, productId])
  @@index([dailyLedgerId, lotOriginKey])
  @@index([ledgerInventoryItemId])
  @@index([productId])
  @@index([sourceType])
  @@index([sourcePurchaseItemId])
  @@index([sourceBusinessDate])
}

model LedgerInventoryAdjustment {
  id                    String                          @id @default(cuid())
  dailyLedgerId         String
  productId             String
  ledgerInventoryItemId String?                         @unique
  productName           String
  productCategory       String
  productSpec           String
  unitPrice             Int
  beforeQuantity        Decimal                         @db.Decimal(12, 2)
  beforeAmount          Int
  afterQuantity         Decimal                         @db.Decimal(12, 2)
  afterAmount           Int
  differenceQuantity    Decimal                         @db.Decimal(12, 2)
  differenceAmount      Int
  amountStatus          InventoryAdjustmentAmountStatus @default(POLICY_UNCONFIRMED)
  reason                String
  createdById           String
  updatedById           String
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  dailyLedger         DailyLedger          @relation(fields: [dailyLedgerId], references: [id], onDelete: Restrict)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  ledgerInventoryItem LedgerInventoryItem? @relation(fields: [ledgerInventoryItemId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("LedgerInventoryAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           User                 @relation("LedgerInventoryAdjustmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([dailyLedgerId, productId], map: "ledgerInventoryAdjustment_dailyLedgerId_productId_key")
  @@index([dailyLedgerId])
  @@index([productId])
  @@index([createdById])
  @@index([updatedById])
}

model LedgerLossItem {
  id                String   @id @default(cuid())
  dailyLedgerId     String
  productId         String
  ledgerInputCodeId String
  productName       String
  productCategory   String
  productSpec       String
  unitPrice         Int
  lossTypeName      String
  quantity          Decimal  @db.Decimal(12, 2)
  recoveredAmount   Int      @default(0)
  amount            Int
  usedPlannedPrice  Boolean  @default(false)
  reason            String
  createdById       String
  updatedById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lotAllocations LedgerLossLotAllocation[]

  dailyLedger     DailyLedger     @relation(fields: [dailyLedgerId], references: [id], onDelete: Restrict)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  ledgerInputCode LedgerInputCode @relation(fields: [ledgerInputCodeId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("LedgerLossItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User            @relation("LedgerLossItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([dailyLedgerId])
  @@index([productId])
  @@index([ledgerInputCodeId])
  @@index([createdById])
  @@index([updatedById])
}

// 당일 손실을 FIFO 입고분에 먼저 나눈 결과. 판매량은 각 lot의 전체 소진량에서
// 이 수량을 뺀 값으로 확정한다. lot row 자체는 재계산 때 다시 만들어지므로 영구
// lotOriginKey로 연결하고 직접 FK는 두지 않는다.
model LedgerLossLotAllocation {
  id               String   @id @default(cuid())
  dailyLedgerId    String
  ledgerLossItemId String
  productId        String
  lotOriginKey     String
  quantity         Decimal  @db.Decimal(12, 2)
  unitCost         Int
  plannedUnitPrice Int
  costAmount       Int
  grossLossAmount  Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dailyLedger    DailyLedger    @relation(fields: [dailyLedgerId], references: [id], onDelete: Cascade)
  ledgerLossItem LedgerLossItem @relation(fields: [ledgerLossItemId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([dailyLedgerId, productId])
  @@index([ledgerLossItemId])
  @@index([dailyLedgerId, lotOriginKey])
}

// WO-05(2026-06-22): 일일 장부에 종속된 라인 단위 인건비/급여 기록.
// DailyLedger.workerCount/workMemo는 단순 요약 역할을 유지하고, 직원별 이름·금액·
// 지각/조퇴/특이사항은 이 모델에 별도로 저장한다.
model LedgerLaborItem {
  id             String   @id @default(cuid())
  dailyLedgerId  String
  employeeId     String?
  workerName     String
  amount         Int
  lateMemo       String?
  earlyLeaveMemo String?
  specialMemo    String?
  createdById    String
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dailyLedger DailyLedger @relation(fields: [dailyLedgerId], references: [id], onDelete: Restrict)
  employee    Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdBy   User        @relation("LedgerLaborItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User        @relation("LedgerLaborItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([dailyLedgerId])
  @@index([employeeId])
  @@index([createdById])
  @@index([updatedById])
}

model InventoryOpeningSnapshot {
  id              String   @id @default(cuid())
  storeId         String
  yearMonth       String
  productId       String
  productName     String
  productCategory String
  productSpec     String
  unitPrice       Int
  quantity        Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([storeId, yearMonth, productId], map: "inventoryOpeningSnapshot_storeId_yearMonth_productId_key")
  @@index([storeId, yearMonth])
  @@index([productId])
}

// WO-06(2026-06-22): 개점 전 지점장이 입력하는 품목별 예상 판매가 계획.
// DailyLedger와는 독립된 운영 계획 엔티티로, 지점/영업일/품목 단위로 1행을 유지한다.
// 실제 품목별 판매가가 없으므로 계획-실적 비교 금액은 모두 추정(estimated)으로만 노출한다.
model StoreSalesPricePlan {
  id               String   @id @default(cuid())
  storeId          String
  businessDate     DateTime
  productId        String
  plannedUnitPrice Int
  memo             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String
  updatedById      String

  store     Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy User    @relation("StoreSalesPricePlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User    @relation("StoreSalesPricePlanUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([storeId, businessDate, productId], map: "storeSalesPricePlan_storeId_businessDate_productId_key")
  @@index([storeId, businessDate])
  @@index([productId])
  @@index([createdById])
  @@index([updatedById])
}

// 장부의 입고분별 판매가. StoreSalesPricePlan은 과거 품목 단위 자료와 새 lot의
// 기본값으로 남기고, 실제 당일 수정값은 이 모델에 저장한다.
model LedgerLotSalesPricePlan {
  id               String   @id @default(cuid())
  dailyLedgerId    String
  productId        String
  lotOriginKey     String
  plannedUnitPrice Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String
  updatedById      String

  dailyLedger DailyLedger @relation(fields: [dailyLedgerId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("LedgerLotSalesPricePlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User        @relation("LedgerLotSalesPricePlanUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([dailyLedgerId, lotOriginKey], map: "ledgerLotSalesPricePlan_dailyLedgerId_lotOriginKey_key")
  @@index([dailyLedgerId, productId])
  @@index([lotOriginKey])
  @@index([createdById])
  @@index([updatedById])
}

// WO-07(2026-06-22): 본사 전용 지출. 지점 일일 장부(DailyLedger)의 비용과 분리된
// 별도 엔티티로, 지점장에게는 노출하지 않고 본사 P&L/리포트에만 별도 라인으로 반영한다.
// storeId는 선택 사항이며, 지정 시 본사 사용자의 지점 권한 범위 내여야 한다(귀속 표시용).
model HeadquartersExpense {
  id               String   @id @default(cuid())
  expenseDate      DateTime
  storeId          String?
  category         String
  amount           Int
  adjustmentReason String?
  memo             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String
  updatedById      String

  store     Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdBy User   @relation("HeadquartersExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User   @relation("HeadquartersExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([expenseDate])
  @@index([storeId, expenseDate])
  @@index([createdById])
  @@index([updatedById])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// WO-11(2026-06-22): 이카운트 매입 미리보기 세션. preview 시 서버에서 파싱한 rows를 저장하고,
// commit은 importSessionId만 받아 여기서 rows를 읽는다. 클라이언트 rows 조작을 원천 차단한다.
model EcountImportSession {
  id            String   @id @default(cuid())
  ledgerId      String
  actorId       String
  purchasesJson Json
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([ledgerId])
  @@index([actorId])
  @@index([expiresAt])
}

// WO(2026-06-24): 이카운트 출고/입고 업로드 batch. 원본 파일 단위 보존. 같은 파일은 fileHash로 차단한다.
// status: PREVIEW, MAPPING_REQUIRED, READY, COMMITTED, FAILED, VOIDED
model EcountImportBatch {
  id            String    @id @default(cuid())
  fileName      String
  fileHash      String    @unique
  sheetName     String
  businessDate  DateTime?
  status        String    @default("PREVIEW")
  errorMessage  String?
  voidReason    String?
  uploadedById  String
  committedById String?
  voidedById    String?
  createdAt     DateTime  @default(now())
  committedAt   DateTime?
  voidedAt      DateTime?

  lines       EcountImportLine[]
  uploadedBy  User               @relation("EcountImportBatchUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  committedBy User?              @relation("EcountImportBatchCommittedBy", fields: [committedById], references: [id], onDelete: SetNull)
  voidedBy    User?              @relation("EcountImportBatchVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([uploadedById])
}

// WO(2026-06-24): 이카운트 원본 행 1건. 원본(raw*)과 매핑/장부 반영 결과를 함께 보존한다.
// unitPrice는 원본 이카운트 단가다. 장부 적용 단가는 LedgerPurchaseItem.unitPrice가 별도로 보존한다.
// status: PREVIEW, MAPPING_REQUIRED, READY, EXCLUDED, COMMITTED, FAILED, VOIDED
model EcountImportLine {
  id                   String  @id @default(cuid())
  batchId              String
  rowNumber            Int
  dateNo               String
  rawStoreName         String
  storeId              String?
  rawProductName       String
  productId            String?
  productName          String
  productCategory      String
  productSpec          String
  quantity             Decimal @db.Decimal(12, 2)
  unitPrice            Int
  supplyAmount         Int
  totalAmount          Int
  status               String  @default("PREVIEW")
  errorMessage         String?
  ledgerPurchaseItemId String?

  batch              EcountImportBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  store              Store?              @relation(fields: [storeId], references: [id], onDelete: SetNull)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  ledgerPurchaseItem LedgerPurchaseItem? @relation("EcountImportLineLedgerPurchaseItem")

  @@unique([batchId, rowNumber])
  @@index([storeId])
  @@index([productId])
  @@index([status])
}

// WO(2026-06-24): 외부 거래처명 → 앱 지점 매핑. 승인된 매핑은 다음 업로드에서 자동 적용한다.
model StoreExternalAlias {
  id          String   @id @default(cuid())
  provider    String   @default("ECOUNT")
  rawName     String
  storeId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("StoreExternalAliasUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([provider, rawName])
  @@index([storeId])
  @@index([updatedById])
}

// WO(2026-06-24): 외부 품목명/규격 → 앱 품목 매핑. 승인된 매핑은 다음 업로드에서 자동 적용한다.
model ProductExternalAlias {
  id          String   @id @default(cuid())
  provider    String   @default("ECOUNT")
  rawName     String
  rawSpec     String   @default("")
  productId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("ProductExternalAliasUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([provider, rawName, rawSpec])
  @@index([productId])
  @@index([updatedById])
}

// WO-08(2026-06-22): 직원 마스터. 일일 장부의 LedgerLaborItem과 선택적으로 연결하여
// 본사에서 직원별 월간 급여 롤업을 집계할 수 있다. 기존 자유텍스트 workerName 행은 그대로 동작한다.
// 고객 Excel 원본 전체와 정규화 결과를 묶는 불변 import batch.
// sourceWorkbook을 함께 보관해 셀 밖 workbook 정보까지 원본 그대로 복구할 수 있다.
model HistoricalExcelImportBatch {
  id                      String    @id @default(cuid())
  fileHash                String    @unique
  sourceFileName          String
  sourceFileSize          Int
  sourceWorkbook          Bytes
  status                  String    @default("STAGING")
  sheetCount              Int
  rawRowCount             Int
  canonicalFactCount      Int
  roleCount               Int
  sourceNameCount         Int
  duplicateStoreDateCount Int
  validationSummary       Json
  previousActiveBatchId   String?
  stagedAt                DateTime?
  activatedAt             DateTime?
  deactivatedAt           DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  rawRows             HistoricalExcelRawRow[]
  dailyFacts          HistoricalDailyFact[]
  historicalEmployees HistoricalEmployee[]
  dailyRoles          HistoricalEmployeeDailyRole[]

  @@index([status])
  @@index([activatedAt])
}

// 10개 시트의 실제 사용 행. rawCells에는 주소/type/formula/cache/error/blank를 모두 담는다.
model HistoricalExcelRawRow {
  id         String @id @default(cuid())
  batchId    String
  sheetIndex Int
  sheetName  String
  rowNumber  Int
  rawCells   Json

  batch      HistoricalExcelImportBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  dailyFacts HistoricalDailyFact[]
  dailyRoles HistoricalEmployeeDailyRole[]

  @@unique([batchId, sheetIndex, rowNumber])
  @@unique([id, batchId])
  @@index([batchId, sheetName])
}

// `입력` 시트에서 지점/일자 중복의 첫 행만 canonical fact로 승격한다.
model HistoricalDailyFact {
  id                    String   @id @default(cuid())
  batchId               String
  sourceRawRowId        String
  storeId               String
  sourceStoreName       String
  businessDate          DateTime
  salesAmount           Decimal? @db.Decimal(24, 8)
  grossProfit           Decimal? @db.Decimal(24, 8)
  grossMarginRate       Decimal? @db.Decimal(24, 12)
  sourceOperatingProfit Decimal? @db.Decimal(24, 8)
  productivity          Decimal? @db.Decimal(24, 8)
  workerCount           Decimal? @db.Decimal(12, 4)
  metricStatus          Json
  createdAt             DateTime @default(now())

  batch        HistoricalExcelImportBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sourceRawRow HistoricalExcelRawRow         @relation(fields: [sourceRawRowId, batchId], references: [id, batchId], onDelete: Restrict)
  store        Store                         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  dailyRoles   HistoricalEmployeeDailyRole[]

  @@unique([batchId, storeId, businessDate])
  @@unique([id, batchId])
  @@index([batchId, businessDate])
  @@index([storeId, businessDate])
}

// 원본 이름 자체가 identity다. 현재 Employee와 이름으로 자동 연결하지 않는다.
model HistoricalEmployee {
  id                String   @id @default(cuid())
  batchId           String
  originalName      String
  reviewStatus      String   @default("UNLINKED")
  firstSeenWorkDate DateTime
  lastSeenWorkDate  DateTime
  leadRoleCount     Int      @default(0)
  memberRoleCount   Int      @default(0)
  storeNames        Json
  createdAt         DateTime @default(now())

  batch      HistoricalExcelImportBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  dailyRoles HistoricalEmployeeDailyRole[]

  @@unique([batchId, originalName])
  @@unique([id, batchId])
  @@index([batchId, firstSeenWorkDate])
  @@index([originalName])
}

// 직급이 아니라 해당 날짜/슬롯의 역할 배정이다.
model HistoricalEmployeeDailyRole {
  id                   String                 @id @default(cuid())
  batchId              String
  historicalEmployeeId String
  dailyFactId          String
  sourceRawRowId       String
  businessDate         DateTime
  storeId              String
  role                 HistoricalEmployeeRole
  slotNumber           Int
  originalName         String
  createdAt            DateTime               @default(now())

  batch              HistoricalExcelImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  historicalEmployee HistoricalEmployee         @relation(fields: [historicalEmployeeId, batchId], references: [id, batchId], onDelete: Restrict)
  dailyFact          HistoricalDailyFact        @relation(fields: [dailyFactId, batchId], references: [id, batchId], onDelete: Restrict)
  sourceRawRow       HistoricalExcelRawRow      @relation(fields: [sourceRawRowId, batchId], references: [id, batchId], onDelete: Restrict)
  store              Store                      @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([batchId, sourceRawRowId, role, slotNumber])
  @@index([historicalEmployeeId, businessDate])
  @@index([storeId, businessDate])
  @@index([batchId, businessDate])
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  hireDate  DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  storeId   String?

  // WO-25(2026-07-25) #6/#8: 등록 시 상세 설정. 하루 인건비와 월 희망 수령액(4대보험/현금)
  // 분해. 기존 직원은 미입력 상태(null)로 남아 값이 있는 직원만 화면에 표시된다.
  dailyWage              Int?
  desiredInsuranceAmount Int?
  desiredCashAmount      Int?

  // WO-0806 #1: 인사관리 카드. 급여 지급 실무에 필요한 연락/계좌 정보와 직급.
  // 직급은 사람의 기본 직급이며, 그날의 근무 역할(팀장/팀원)과는 다르다.
  phone       String?
  bankAccount String?
  address     String?
  position    String?

  laborItems LedgerLaborItem[]
  store      Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([storeId])
}

// WO-10(2026-06-22): LINE 아침 요약 알림 전송 로그.
// 알림 provider, 템플릿 키, 수신자 ID, 전송 상태를 기록한다.
model NotificationDeliveryLog {
  id          String   @id @default(cuid())
  provider    String
  templateKey String
  recipientId String
  sentAt      DateTime @default(now())
  status      String
  error       String?

  @@index([templateKey, sentAt])
  @@index([recipientId, sentAt])
}
